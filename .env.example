# Project URL and the public (anon / publishable) key from
# Supabase Dashboard -> Project Settings -> API.
# Only the public key is ever used. The service role key is NOT needed and
# must never be added here or anywhere else in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
